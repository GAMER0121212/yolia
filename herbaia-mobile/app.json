{
  "expo": {
    "name": "Yolia",
    "slug": "herbaia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/YOLIA.png",
    "scheme": "yolia",
    "userInterfaceStyle": "automatic",

    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.yolia.app"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.yolia.app"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/YOLIA-W.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/YOLIA-W.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#183326",
          "dark": {
            "image": "./assets/images/YOLIA-W.png",
            "backgroundColor": "#183326"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.617736950097-relht0jl93r6ralsfc1g78i6d6fco0ou"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2e8c9c2-4491-4cfa-8159-109d4bae49db"
      }
    },

    "owner": "panquesito_uwu"
  }
}